# این فایل رو کپی کن به اسم .env و مقادیر واقعی خودتو جایگزین کن
# دستور: cp .env.example .env
# بعد فایل .env رو ویرایش کن (nano .env)
# هرگز فایل .env رو آپلود نکن گیت‌هاب!

# --- تنظیمات اصلی بات (اجباری) ---
BOT_TOKEN=توکن_بات_از_BotFather
BOT_USERNAME=username_bat_بدون_@
ADMIN_IDS=123456789,987654321

# --- پشتیبانی ---
SUPPORT_USERNAME=username_پشتیبانی

# --- کیف‌پول‌های کریپتو ---
WALLET_TRX=آدرس_کیف‌پول_ترون_شما
WALLET_TON=آدرس_کیف‌پول_تون_شما
TON_API_KEY=کلید_API_از_ربات_tonapibot

# --- پرداخت ریالی ---
CARD_NUMBER=6037-XXXX-XXXX-XXXX
CARD_OWNER=نام صاحب کارت

# --- کانال و گزارش‌دهی ---
ORDER_CHANNEL_ID=آیدی_عددی_کانال_سفارشات
REPORT_CHANNEL_ID=آیدی_عددی_کانال_گزارشات
REPORT_TOPIC_ID=آیدی_تاپیک_گزارشات

# --- مینی‌اپ (در صورت استفاده) ---
MINIAPP_DOMAIN=example.com

# --- Marketapp (خرید خودکار استارز/پرمیوم/گیفت) ---
MARKETAPP_TOKEN=توکن_Marketapp
MARKETAPP_WALLET_MNEMONIC=۲۴_کلمه_کیف‌پول_اختصاصی_Marketapp

# --- تنظیمات پیش‌فرض (نیازی به تغییر نیست معمولاً) ---
REFERRAL_PERCENT=5
NFT_GIFT_FEE_PERCENT=5
MIN_STARS_AMOUNT=50
MIN_REACTION_AMOUNT=10
DB_PATH=bot.db

